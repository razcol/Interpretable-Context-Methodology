# Stage outputs (per-run artifacts, not part of the workspace definition)
**/stages/*/output/*
!**/stages/*/output/.gitkeep

# Local flowchart read of a workspace (generated diagram, not the workspace definition)
workspaces/figma-section-fields/flowchart/

# Workspace-builder stage outputs (intermediate build artifacts)
workspaces/workspace-builder/stages/*/output/*
!workspaces/workspace-builder/stages/*/output/.gitkeep

# Claude Code local settings
.claude/

# Node dependencies
node_modules/

# Python artifacts
__pycache__/
*.pyc
.venv/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
*.swp
*.swo
*~
.vscode/settings.json

# Environment files
.env
.env.local

# Cloned reference repos (local only)
*-ref/
